// codebase-memory-cli:managed: generated by `codebase-memory-cli install`;
// remove with `codebase-memory-cli uninstall --copilot`. Edit freely after deleting this line.
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cbm: index repository",
      "type": "process",
      "command": "codebase-memory-cli",
      "args": ["cli", "--quiet", "index_repository", "--repo-path", "${workspaceFolder}"],
      "problemMatcher": []
    },
    {
      "label": "cbm: list projects",
      "type": "process",
      "command": "codebase-memory-cli",
      "args": ["cli", "--quiet", "list_projects", "--format", "json"],
      "problemMatcher": []
    },
    {
      "label": "cbm: who calls",
      "type": "process",
      "command": "codebase-memory-cli",
      "args": ["cli", "--quiet", "trace_path", "--project", "${input:cbmProject}",
               "--function-name", "${input:cbmSymbol}", "--direction", "inbound",
               "--format", "json"],
      "problemMatcher": []
    },
    {
      "label": "cbm: architecture",
      "type": "process",
      "command": "codebase-memory-cli",
      "args": ["cli", "--quiet", "get_architecture", "--project", "${input:cbmProject}",
               "--format", "json"],
      "problemMatcher": []
    },
    {
      "label": "cbm: graph UI (127.0.0.1)",
      "type": "process",
      "command": "codebase-memory-cli",
      "args": ["ui"],
      "isBackground": true,
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "cbmProject",
      "type": "promptString",
      "description": "Project name (run the 'cbm: list projects' task)"
    },
    {
      "id": "cbmSymbol",
      "type": "promptString",
      "description": "Function name"
    }
  ]
}
